{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "hono",
    "outputDirectory": "src",
    "rewrites": [
        {
            "source": "/favicon.ico",
            "destination": "/favicon.png"
        }
    ],
    "installCommand": "pnpm install --no-frozen-lockfile",
    "functions": {
        "src/**/*.ts": {
            "includeFiles": [
                "node_modules/.pnpm/patchright-core@*/node_modules/patchright-core/browsers.json"
            ]
        },
        "src/**/*.js": {
            "includeFiles": [
                "node_modules/.pnpm/patchright-core@*/node_modules/patchright-core/browsers.json"
            ]
        }
    },
    "github": {
        "silent": true
    }
}
